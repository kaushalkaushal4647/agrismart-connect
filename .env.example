# AgriSmart Connect Environment Configuration

# Flask Application
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_PORT=5000
SECRET_KEY=supersecret-agrismart-key-change-in-production

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrismart
DB_USER=postgres
DB_PASSWORD=postgres

# Connection Pool Settings
DB_MIN_CONNECTIONS=1
DB_MAX_CONNECTIONS=10
DB_TIMEOUT=30

# Cloud PostgreSQL URI (Alternative to individual DB_* fields above)
# e.g. for Neon, Supabase, or Render PostgreSQL:
DATABASE_URL=

# AI Configuration (Free Cloud AI in Production / Ollama in Local Dev)
# Free API key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OLLAMA_HOST=http://localhost:11434
